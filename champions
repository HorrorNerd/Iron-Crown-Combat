<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Iron Crown Combat — Hall of Champions</title>
  <meta name="description" content="Current and past ICC title holders: King of the Crown champion history." />
  <meta property="og:title" content="Iron Crown Combat — Hall of Champions" />
  <meta property="og:description" content="Current and past ICC title holders." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://horrornerd.github.io/Iron-Crown-Combat/assets/images/fighters/champion/maddox-champion-card.png" />
  <style>
    :root{
      /* ICC-leaning palette */
      --bg: #0a0a0f;
      --card: #13131a;
      --ring: #262638;
      --muted: #aeb5cc;
      --text: #eaf0ff;
      --accent: #ff6a00;       /* ICC orange */
      --accent-2:#ffb86b;
      --shadow: 0 10px 30px rgba(0,0,0,.45);
      --radius: 18px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Arial,sans-serif}
    a{color:inherit;text-decoration:none}
    img{display:block;max-width:100%}

    .container{max-width:1100px;margin:auto;padding:24px}
    header.page{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:20px}
    header.page h1{font-size:clamp(1.6rem,3vw,2.2rem);margin:0}
    header.page small{color:var(--muted)}

    .hero{
      position:relative;
      border-radius:var(--radius);
      overflow:hidden;
      box-shadow:var(--shadow);
      background:linear-gradient(180deg,#161621,#0c0c13);
      min-height: 420px;
      isolation:isolate;
    }
    .hero img.bg{
      position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
      filter:saturate(1.05) contrast(1.05) brightness(.92);
      z-index:-2;
    }
    .hero::after{
      content:""; position:absolute; inset:0;
      background:linear-gradient(to top, rgba(0,0,0,.7), rgba(0,0,0,.25) 55%, rgba(0,0,0,0) 80%);
      z-index:-1;
    }
    .belt-badge{
      position:absolute; top:14px; left:14px;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      color:#181818; font-weight:800; letter-spacing:.5px;
      border-radius:999px; padding:8px 14px; box-shadow:var(--shadow);
      border:1px solid #00000033;
    }
    .overlay{
      position:absolute; left:0; right:0; bottom:0; padding:16px 18px;
      background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.55) 30%,rgba(0,0,0,.78) 100%);
      display:flex; flex-direction:column; gap:4px;
    }
    .overlay .name{ font-weight:900; font-size:clamp(1.35rem,3.2vw,2rem); text-shadow:0 2px 16px rgba(0,0,0,.55)}
    .overlay .meta{ color:var(--muted); font-size:.95rem }

    .past{ margin-top:28px; border:1px solid var(--ring); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); background:linear-gradient(180deg,#12121a,#0c0c12) }
    .past header{ padding:12px 16px; background:linear-gradient(90deg,rgba(255,106,0,.12),rgba(255,184,107,.05)); border-bottom:1px solid var(--ring) }
    .past header h2{ margin:0; font-size:1.05rem; letter-spacing:.4px }
    .list{ display:flex; flex-direction:column }

    .champ-row{ display:grid; grid-template-columns:64px 1fr auto; gap:12px; align-items:center; padding:12px 16px; border-bottom:1px solid var(--ring) }
    .champ-row:last-child{ border-bottom:none }
    .headshot{ width:64px; height:64px; border-radius:12px; overflow:hidden; border:1px solid var(--ring); background:#0a0a0d }
    .titleline{ line-height:1.15 }
    .titleline .n{ font-weight:800 }
    .titleline .dates{ font-size:.9rem; color:var(--muted); margin-top:4px }
    .more a{ font-size:.9rem; padding:8px 10px; border:1px solid var(--ring); border-radius:10px; background:#0f0f16 }
    .more a:hover{ border-color:var(--accent); box-shadow:0 0 0 2px rgba(255,106,0,.15) inset }

    .tip{font-size:.9rem;color:var(--muted);margin-top:6px}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

    @media (max-width:640px){
      .champ-row{ grid-template-columns:56px 1fr }
      .more{ display:none }
      .hero{ min-height: 360px }
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="page">
      <h1>Hall of Champions</h1>
      <small>Current and past ICC title holders</small>
      <div class="tip">To update: edit the <code>champions</code> array or call <code>addNewChampion({...})</code>. The previous champ will automatically drop into the Past list.</div>
    </header>

    <!-- Current Champion (hero card) -->
    <section id="current" class="hero" aria-label="Current Champion">
      <span class="belt-badge" aria-hidden="true">KING OF THE CROWN</span>
      <img id="currentImg" class="bg" alt="" />
      <div class="overlay">
        <div class="name" id="currentName">Loading…</div>
        <div class="meta" id="currentMeta">—</div>
      </div>
    </section>

    <!-- Past Champions -->
    <section class="past" aria-label="Past Champions">
      <header><h2>Past Champions</h2></header>
      <div id="pastList" class="list"></div>
    </section>

    <noscript>
      <p style="margin-top:16px;color:var(--muted)">JavaScript is required to render the champions list.</p>
    </noscript>
  </div>

  <script>
    /* ====== CONFIG ====== */
    const FIGHTERS_PAGE_URL = 'https://horrornerd.github.io/Iron-Crown-Combat/fighters.html';

    // IMPORTANT: Use your GitHub Pages URLs (not github.com/blob links) for images
    let champions = [
      {
        name: "Cole Maddox",
        slug: "cole-maddox", // make sure Fighters page has id="cole-maddox"
        start: "2025-06-15",
        end: null,
        heroImage: "https://horrornerd.github.io/Iron-Crown-Combat/assets/images/fighters/champion/maddox-champion-card.png",
        headshot: "https://horrornerd.github.io/Iron-Crown-Combat/assets/images/fighters/headshots/cole-maddox.png",
        titleName: "KING OF THE CROWN"
      },
      {
        name: "Master Bo Quin",
        slug: "master-bo-quin",
        start: "2025-05-26",
        end: "2025-06-15",
        heroImage: "https://horrornerd.github.io/Iron-Crown-Combat/assets/images/fighters/champions/_archive-bo-quin-hero.jpg", // optional archive art
        headshot: "https://horrornerd.github.io/Iron-Crown-Combat/assets/images/fighters/headshots/master-bo-quin.png",
        titleName: "KING OF THE CROWN"
      }
      // Add older reigns here…
    ];

    /* ====== HELPERS ====== */
    function fmtDate(iso){
      const d = new Date(iso);
      if (isNaN(d)) return iso;
      return d.toLocaleDateString(undefined, {month:'short', day:'2-digit', year:'numeric'});
    }
    function fighterLink(slug){ return `${FIGHTERS_PAGE_URL}#${encodeURIComponent(slug)}`; }

    /* ====== RENDER ====== */
    function render(){
      if (!champions.length) return;
      const cur = champions[0];
      const currentImg = document.getElementById('currentImg');
      const currentName = document.getElementById('currentName');
      const currentMeta = document.getElementById('currentMeta');
      const badge = document.querySelector('.belt-badge');

      currentImg.src = cur.heroImage;
      currentImg.alt = `${cur.name} — Current Champion`;
      currentName.innerHTML = `<a href="${fighterLink(cur.slug)}" aria-label="View ${cur.name}'s profile">${cur.name}</a>`;
      currentMeta.textContent = `Reign began ${fmtDate(cur.start)}`;
      badge.textContent = cur.titleName || 'CHAMPION';

      const past = champions.slice(1);
      const list = document.getElementById('pastList');
      list.innerHTML = '';
      past.forEach(ch => {
        const row = document.createElement('div');
        row.className = 'champ-row';

        const imgWrap = document.createElement('a');
        imgWrap.className = 'headshot';
        imgWrap.href = fighterLink(ch.slug);
        imgWrap.setAttribute('aria-label', `View ${ch.name}'s profile`);
        const img = document.createElement('img');
        img.src = ch.headshot;
        img.alt = `${ch.name} headshot`;
        imgWrap.appendChild(img);

        const text = document.createElement('div');
        text.className = 'titleline';
        const dates = ch.end ? `${fmtDate(ch.start)} – ${fmtDate(ch.end)}` : `${fmtDate(ch.start)} – —`;
        text.innerHTML = `<div class="n">${ch.name}</div><div class="dates">${dates}</div>`;

        const more = document.createElement('div');
        more.className = 'more';
        more.innerHTML = `<a href="${fighterLink(ch.slug)}" aria-label="Go to ${ch.name}">View profile</a>`;

        row.appendChild(imgWrap);
        row.appendChild(text);
        row.appendChild(more);
        list.appendChild(row);
      });
    }

    /* ====== API: add a new champion ====== */
    function addNewChampion({ name, slug, startISO, heroImage, headshot, titleName, endPrevISO }){
      if (champions.length){
        champions[0] = { ...champions[0], end: endPrevISO || startISO };
      }
      champions.unshift({ name, slug, start: startISO, end: null, heroImage, headshot, titleName: titleName || champions[1]?.titleName || 'CHAMPION' });
      render();
    }

    // Expose helper for console usage if needed
    window.addNewChampion = addNewChampion;

    // Kick off
    render();
  </script>
</body>
</html>
